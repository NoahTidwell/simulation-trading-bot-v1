# ---------------------------------------------------------------------------
# simulation_trading_bot_v1 â€” environment
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# THERE IS NO WALLET, PRIVATE KEY, OR SIGNING KEY IN THIS PROJECT.
# Every value here is a read-only data-API key or a simulation parameter.
# ---------------------------------------------------------------------------

# --- Data / security APIs (read-only) --------------------------------------

# Helius: used for candidate discovery (recent Raydium / pump.fun program
# activity via the Enhanced Transactions API) and as the RPC endpoint for
# read-only mint-account lookups. Without it, discovery is disabled and only
# WATCHLIST_MINTS seeds are evaluated.
HELIUS_API_KEY=your-helius-api-key

# Optional: override the RPC URL. Defaults to Helius RPC when HELIUS_API_KEY
# is set, otherwise the public mainnet endpoint (heavily rate-limited).
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key

# RugCheck: the public report endpoint works without a key; a key raises
# rate limits. Sent as a Bearer token when present.
RUGCHECK_API_KEY=

# GoPlus: the public endpoint works without a key. If you have an access
# token it is sent in the Authorization header.
GOPLUS_ACCESS_TOKEN=

# Jupiter: quote + price APIs. The free tier (lite-api) needs no key.
# If you set a key, the base URL switches to api.jup.ag automatically.
JUPITER_API_KEY=
# JUPITER_API_BASE=https://lite-api.jup.ag

# --- Simulation parameters --------------------------------------------------

# Simulated starting bankroll in USD. Not real money.
STARTING_BANKROLL_USD=500

# Estimated per-transaction network costs (SOL) applied to every simulated
# fill. Tune to current network conditions.
PRIORITY_FEE_SOL=0.001
JITO_TIP_SOL=0.0005

# How often to poll Helius for new candidates (ms). Each poll = 3 Enhanced
# Transactions calls ≈ 300 credits. Default 900000 (15 min) ≈ 29k credits/day,
# which fits the 1M/month free tier. Entries need 30 min of history anyway,
# so faster polling doesn't produce earlier trades.
DISCOVERY_INTERVAL_MS=900000

# Optional comma-separated token mints to seed the watchlist with on startup
# (useful for testing the pipeline). They still have to pass every gate.
WATCHLIST_MINTS=

# Log level: debug | info | warn
LOG_LEVEL=info
